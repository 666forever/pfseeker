---
import Dialog from "@/components/Dialog.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Collections"
  description="Manage an anonymous local pfseeker collection stored in this browser."
>
  <section
    class="page-shell collection-page"
    aria-labelledby="collections-title"
    data-collection-page
  >
    <div class="page-hero">
      <p class="eyebrow">Collections</p>
      <h1 id="collections-title">Your local collection</h1>
      <p>
        This collection is stored only in this browser. It is not synced to an
        account, and clearing browser data may remove it.
      </p>
    </div>

    <section class="collection-panel" aria-labelledby="collection-name-title">
      <div>
        <h2 id="collection-name-title">Collection name</h2>
        <p data-collection-storage-warning class="collection-warning" hidden>
        </p>
      </div>
      <form class="collection-rename" data-collection-rename>
        <label for="collection-name">Name</label>
        <input
          id="collection-name"
          name="name"
          maxlength="64"
          autocomplete="off"
          data-collection-name-input
        />
        <button class="button button--secondary button--md" type="submit">
          Save name
        </button>
        <button
          class="button button--ghost button--md"
          type="button"
          data-collection-name-cancel
        >
          Cancel
        </button>
      </form>
      <p
        class="collection-feedback"
        data-collection-rename-feedback
        role="status"
        aria-live="polite"
      >
      </p>
    </section>

    <section class="collection-panel" aria-labelledby="collection-items-title">
      <div class="collection-panel__header">
        <div>
          <h2 id="collection-items-title">Saved assets</h2>
          <p data-collection-page-count>Collection loading.</p>
        </div>
        <div class="collection-actions">
          <button
            class="button button--secondary button--md"
            type="button"
            data-collection-download
            disabled
          >
            Download collection ZIP
          </button>
          <button
            class="button button--ghost button--md"
            type="button"
            data-zip-cancel
            hidden
          >
            Cancel download
          </button>
          <button
            class="button button--danger button--md"
            type="button"
            data-dialog-open="clear-collection-dialog"
            data-collection-clear-open
            disabled
          >
            Clear collection
          </button>
        </div>
      </div>

      <div class="collection-progress" data-zip-panel hidden>
        <p data-zip-status role="status" aria-live="polite"></p>
        <progress data-zip-progress value="0" max="1"></progress>
        <ul data-zip-failures></ul>
      </div>

      <section
        class="route-empty"
        data-collection-empty
        hidden
        aria-labelledby="collection-empty-title"
      >
        <h3 id="collection-empty-title">Nothing saved yet</h3>
        <p>
          Start with a gallery and save assets into this browser-local
          collection.
        </p>
        <p>
          <a class="button button--secondary button--md" href="/pfps"
            >Browse profile pictures</a
          >
        </p>
      </section>

      <div class="collection-missing" data-collection-missing hidden>
        <h3>Unavailable saved items</h3>
        <p>
          Some saved IDs no longer match current seed assets. They are preserved
          here so you can remove them deliberately.
        </p>
        <ul data-collection-missing-list></ul>
      </div>

      <ol class="collection-list" data-collection-list></ol>
    </section>
  </section>

  <Dialog
    id="clear-collection-dialog"
    title="Clear local collection?"
    description="This removes every saved asset from this browser-local collection. It cannot be undone."
  >
    <div class="dialog-actions">
      <button
        class="button button--ghost button--md"
        type="button"
        data-dialog-close
      >
        Cancel
      </button>
      <button
        class="button button--danger button--md"
        type="button"
        data-collection-clear-confirm
        data-dialog-close
      >
        Clear collection
      </button>
    </div>
  </Dialog>
</BaseLayout>
