---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  ModerationAuthorizationError,
  requireOwner,
} from "@/server/auth/moderation";
import { AuthenticationRequiredError } from "@/server/auth/session";
import { getAuthConfig } from "@/server/config";
import { createMembershipRevokeToken } from "@/server/services/moderation-membership-actions";

let access;
try {
  access = await requireOwner(Astro);
} catch (error) {
  if (error instanceof AuthenticationRequiredError) {
    return Astro.redirect(
      `/auth/discord?returnTo=${encodeURIComponent("/moderation/members")}`,
      302,
    );
  }
  if (error instanceof ModerationAuthorizationError) {
    return new Response("Not found.", { status: 404 });
  }
  throw error;
}

const [memberships, authConfig] = await Promise.all([
  access.repository.listMemberships(),
  getAuthConfig(Astro.locals),
]);
const activeOwnerCount = memberships.filter(
  (membership) => membership.role === "owner" && membership.status === "active",
).length;
const membershipRevokeTokenEntries: [string, string][] = await Promise.all(
  memberships.map(async (membership): Promise<[string, string]> => [
    membership.id,
    await createMembershipRevokeToken(membership, authConfig),
  ]),
);
const membershipRevokeTokens = new Map<string, string>(
  membershipRevokeTokenEntries,
);

function shortInternalId(value: string): string {
  return value.length > 6 ? `...${value.slice(-6)}` : "redacted";
}

function canRevokeMembership(
  membership: (typeof memberships)[number],
): boolean {
  return !(
    membership.status !== "active" ||
    (membership.role === "owner" && activeOwnerCount <= 1)
  );
}

function isLastActiveOwner(membership: (typeof memberships)[number]): boolean {
  return (
    membership.status === "active" &&
    membership.role === "owner" &&
    activeOwnerCount <= 1
  );
}
---

<BaseLayout
  title="Moderation members"
  description="Owner-only pfseeker moderator membership management."
  noindex
>
  <section class="page-shell" aria-labelledby="members-title">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/moderation">Moderation</a></li>
        <li><span aria-current="page">Members</span></li>
      </ol>
    </nav>

    <div class="page-hero">
      <p class="eyebrow">Owner</p>
      <h1 id="members-title">Moderator memberships</h1>
      <p>
        Memberships are durable D1 records. Revocation invalidates active
        sessions.
      </p>
    </div>

    <section class="collection-panel" aria-labelledby="member-create-title">
      <h2 id="member-create-title">Add member</h2>
      <p>
        Multi-user moderator creation is deferred. The current production
        verification keeps a single durable owner membership.
      </p>
    </section>

    <section class="collection-panel" aria-labelledby="members-list-title">
      <h2 id="members-list-title">Memberships</h2>
      {
        memberships.length === 0 ? (
          <p>No durable memberships yet. Use owner bootstrap first.</p>
        ) : (
          <ol class="collection-list">
            {memberships.map((membership) => (
              <li class="collection-item">
                <div class="collection-item__body">
                  <h3>{membership.role}</h3>
                  <p>
                    {membership.status} / internal user{" "}
                    {shortInternalId(membership.userId)}
                  </p>
                  <p>
                    <time datetime={membership.createdAt}>
                      {membership.createdAt}
                    </time>
                  </p>
                </div>
                {isLastActiveOwner(membership) && (
                  <p class="collection-item__controls">
                    Last active owner cannot be revoked.
                  </p>
                )}
                {canRevokeMembership(membership) && (
                  <form
                    class="collection-item__controls"
                    method="post"
                    action="/api/moderation/members/revoke"
                  >
                    <input
                      type="hidden"
                      name="membershipToken"
                      value={membershipRevokeTokens.get(membership.id)}
                    />
                    <label>
                      Revocation reason
                      <input
                        name="reason"
                        required
                        minlength="2"
                        maxlength="500"
                      />
                    </label>
                    <button
                      class="button button--danger button--sm"
                      type="submit"
                    >
                      Revoke
                    </button>
                  </form>
                )}
              </li>
            ))}
          </ol>
        )
      }
    </section>
  </section>
</BaseLayout>
