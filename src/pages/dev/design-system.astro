---
import Alert from "@/components/Alert.astro";
import Badge from "@/components/Badge.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/Card.astro";
import Checkbox from "@/components/Checkbox.astro";
import Dialog from "@/components/Dialog.astro";
import Drawer from "@/components/Drawer.astro";
import Dropdown from "@/components/Dropdown.astro";
import EmptyState from "@/components/EmptyState.astro";
import IconButton from "@/components/IconButton.astro";
import Radio from "@/components/Radio.astro";
import SearchInput from "@/components/SearchInput.astro";
import Select from "@/components/Select.astro";
import Skeleton from "@/components/Skeleton.astro";
import Spinner from "@/components/Spinner.astro";
import Switch from "@/components/Switch.astro";
import Textarea from "@/components/Textarea.astro";
import TextInput from "@/components/TextInput.astro";
import ToastRegion from "@/components/ToastRegion.astro";
import Tooltip from "@/components/Tooltip.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Design system"
  description="Internal pfseeker design-system showcase for primitive components, states, and accessibility checks."
  noindex
  publicShell={false}
>
  <section class="showcase-shell" aria-labelledby="design-system-title">
    <div class="showcase-hero">
      <p class="eyebrow">Internal development surface</p>
      <h1 id="design-system-title">pfseeker design system</h1>
      <p>
        A dark, restrained, image-first foundation for discovery pages,
        collection tools, and future moderation surfaces. This route is excluded
        from search indexing and is not linked from public navigation.
      </p>
    </div>

    <section class="component-section" aria-labelledby="tokens-title">
      <h2 id="tokens-title">Tokens</h2>
      <div class="component-grid">
        <Card tone="raised">
          <h3>Surface stack</h3>
          <p>Background, recessed, standard, raised, and overlay tones.</p>
          <div class="component-row" aria-label="Surface samples">
            <span class="badge">bg</span>
            <span class="badge badge--accent">accent</span>
            <span class="badge badge--info">info</span>
          </div>
        </Card>
        <Card tone="recessed">
          <h3>Type system</h3>
          <p>
            Interface typography uses system fonts for crisp Windows rendering.
          </p>
          <p class="eyebrow">Profile seeker</p>
        </Card>
      </div>
    </section>

    <section class="component-section" aria-labelledby="buttons-title">
      <h2 id="buttons-title">Buttons</h2>
      <div class="component-row">
        <Button variant="primary">Save asset</Button>
        <Button variant="secondary">Preview</Button>
        <Button variant="ghost">Copy link</Button>
        <Button variant="danger">Report</Button>
        <Button loading>Loading</Button>
        <Button disabled>Disabled</Button>
        <IconButton label="Add to collection" variant="accent">＋</IconButton>
        <IconButton label="Disabled save" disabled>☆</IconButton>
      </div>
    </section>

    <section class="component-section" aria-labelledby="forms-title">
      <h2 id="forms-title">Forms</h2>
      <div class="showcase-grid">
        <Card>
          <TextInput
            id="asset-title"
            label="Asset title"
            placeholder="Midnight chrome avatar"
            help="Use concise editorial names."
          />
          <br />
          <TextInput
            id="asset-invalid"
            label="Slug"
            value="new"
            error="Use at least four characters."
          />
          <br />
          <SearchInput id="asset-search" placeholder="Search dark icons" />
        </Card>
        <Card>
          <Textarea
            id="collection-note"
            label="Collection note"
            placeholder="Describe the visual mood."
          />
          <br />
          <Select
            id="asset-type"
            label="Content type"
            value="pfp"
            options={[
              { label: "Profile picture", value: "pfp" },
              { label: "Banner", value: "banner" },
              { label: "Icon", value: "icon" },
            ]}
          />
        </Card>
      </div>
    </section>

    <section class="component-section" aria-labelledby="choices-title">
      <h2 id="choices-title">Choices</h2>
      <div class="component-row">
        <Checkbox
          id="animated"
          label="Animated only"
          help="Filters motion-capable assets."
          checked
        />
        <Checkbox id="disabled-check" label="Disabled filter" disabled />
        <Radio id="sort-new" name="sort" label="Newest" value="new" checked />
        <Radio id="sort-popular" name="sort" label="Popular" value="popular" />
        <Switch id="safe-preview" label="Reduced-motion previews" checked />
        <Switch id="disabled-switch" label="Disabled switch" disabled />
      </div>
    </section>

    <section class="component-section" aria-labelledby="feedback-title">
      <h2 id="feedback-title">Feedback</h2>
      <div class="showcase-grid">
        <Alert title="Collection saved" tone="success">
          The synced collection update is ready for the signed-in account.
        </Alert>
        <Alert title="Upload unavailable" tone="warning">
          Signed submissions are intentionally deferred until server validation
          exists.
        </Alert>
        <Alert title="Preview failed" tone="danger">
          Asset feedback uses live regions and visible error text.
        </Alert>
        <Alert title="Indexing note" tone="info">
          Internal development routes are protected from search indexing.
        </Alert>
      </div>
      <ToastRegion>Asset added to the private collection.</ToastRegion>
    </section>

    <section class="component-section" aria-labelledby="display-title">
      <h2 id="display-title">Display</h2>
      <div class="showcase-grid">
        <Card tone="raised">
          <h3>Curated asset card</h3>
          <p>
            A card primitive for future gallery items and editorial collections.
          </p>
          <div class="component-row">
            <Badge tone="accent">pfp</Badge>
            <Badge tone="neutral">1200×1200</Badge>
            <Badge tone="success">approved</Badge>
          </div>
        </Card>
        <EmptyState
          title="No saved assets"
          message="Start a collection from gallery results."
        >
          <Button variant="primary">Browse PFPs</Button>
        </EmptyState>
      </div>
      <div class="component-row">
        <Skeleton shape="avatar" />
        <Skeleton shape="text" />
        <Skeleton shape="block" />
        <Spinner />
      </div>
    </section>

    <section class="component-section" aria-labelledby="overlays-title">
      <h2 id="overlays-title">Overlays</h2>
      <div class="component-row">
        <Button variant="primary" data-dialog-open="preview-dialog"
          >Open dialog</Button
        >
        <Button variant="secondary" data-drawer-open="collection-drawer"
          >Open drawer</Button
        >
        <Dropdown id="filter-menu" label="Filter menu">
          <button type="button" role="menuitem">Only square assets</button>
          <button type="button" role="menuitem">Show animated assets</button>
          <a href="/search?type=icon" role="menuitem">Search icons</a>
        </Dropdown>
        <Tooltip
          id="save-tip"
          text="Shortcut labels are supplementary, not essential."
        >
          <IconButton label="Tooltip example">?</IconButton>
        </Tooltip>
      </div>
    </section>
  </section>

  <Dialog
    id="preview-dialog"
    title="Asset preview"
    description="Dialog focus is trapped until Escape, close, or a dismiss action is used."
  >
    <p>Use this pattern for lightboxes, confirmations, and focused editing.</p>
    <div class="component-row">
      <Button variant="primary" data-autofocus>Confirm preview</Button>
      <Button variant="ghost" data-dialog-close>Dismiss</Button>
    </div>
  </Dialog>

  <Drawer
    id="collection-drawer"
    title="Collection tools"
    description="Drawer focus returns to the opener when closed."
  >
    <p>
      Future collection controls will use this foundation for saved assets and
      ZIP progress.
    </p>
    <Button variant="primary">Review collection</Button>
  </Drawer>

  <script>
    import "@/scripts/primitives";
  </script>
</BaseLayout>
