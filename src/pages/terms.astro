---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms"
  description="Early-stage terms for the current read-only pfseeker development site."
>
  <section class="page-shell prose-page" aria-labelledby="terms-title">
    <div class="page-hero">
      <p class="eyebrow">Terms</p>
      <h1 id="terms-title">Early-stage terms</h1>
      <p>
        These terms are suitable only for the current read-only development site
        and are not final production upload or account terms.
      </p>
    </div>
    <section aria-labelledby="terms-current">
      <h2 id="terms-current">Current use</h2>
      <p>
        pfseeker currently publishes informational routes and development-stage
        surfaces. User uploads, accounts, downloads, and moderation features are
        not active.
      </p>
    </section>
    <section aria-labelledby="terms-future">
      <h2 id="terms-future">Before launch</h2>
      <p>
        Final production terms should be reviewed before accounts, submissions,
        creator profiles, reports, or uploaded media become available.
      </p>
    </section>
  </section>
</BaseLayout>
