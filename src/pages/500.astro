---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Server error"
  description="pfseeker encountered a server error."
>
  <section class="status-page" aria-labelledby="server-error-title">
    <p class="eyebrow">500</p>
    <h1 id="server-error-title">Server error</h1>
    <p>The request could not be completed. Try again shortly.</p>
    <a class="text-link" href="/">Return home</a>
  </section>
</BaseLayout>
