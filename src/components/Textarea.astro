---
interface Props {
  id: string;
  label: string;
  value?: string;
  placeholder?: string;
  help?: string;
  error?: string;
  disabled?: boolean;
  rows?: number;
}

const {
  id,
  label,
  value,
  placeholder,
  help,
  error,
  disabled = false,
  rows = 4,
} = Astro.props;
const describedBy = [help && `${id}-help`, error && `${id}-error`]
  .filter(Boolean)
  .join(" ");
---

<label class="field" for={id}>
  <span class="field__label">{label}</span>
  <textarea
    id={id}
    class="field__control field__control--textarea"
    rows={rows}
    placeholder={placeholder}
    disabled={disabled}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy || undefined}>{value}</textarea
  >
  {
    help && (
      <span id={`${id}-help`} class="field__help">
        {help}
      </span>
    )
  }
  {
    error && (
      <span id={`${id}-error`} class="field__error">
        {error}
      </span>
    )
  }
</label>
