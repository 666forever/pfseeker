---
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  introduction: string;
  crumbs?: Crumb[];
}

const { eyebrow, title, introduction, crumbs = [] } = Astro.props;
---

<header class="gallery-heading">
  {
    crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((crumb, index) => (
            <li>
              {index === crumbs.length - 1 ? (
                <span aria-current="page">{crumb.label}</span>
              ) : (
                <a href={crumb.href}>{crumb.label}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p>{introduction}</p>
</header>
