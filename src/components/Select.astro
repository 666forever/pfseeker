---
interface Option {
  label: string;
  value: string;
}

interface Props {
  id: string;
  label: string;
  options: Option[];
  value?: string;
  help?: string;
  error?: string;
  disabled?: boolean;
}

const {
  id,
  label,
  options,
  value,
  help,
  error,
  disabled = false,
} = Astro.props;
const describedBy = [help && `${id}-help`, error && `${id}-error`]
  .filter(Boolean)
  .join(" ");
---

<label class="field" for={id}>
  <span class="field__label">{label}</span>
  <select
    id={id}
    class="field__control"
    disabled={disabled}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy || undefined}
  >
    {
      options.map((option) => (
        <option value={option.value} selected={option.value === value}>
          {option.label}
        </option>
      ))
    }
  </select>
  {
    help && (
      <span id={`${id}-help`} class="field__help">
        {help}
      </span>
    )
  }
  {
    error && (
      <span id={`${id}-error`} class="field__error">
        {error}
      </span>
    )
  }
</label>
