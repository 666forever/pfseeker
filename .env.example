# Public
PUBLIC_SITE_URL=https://pfseeker.com
PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudflare D1
# Binding name: DB
# Database IDs are configured in wrangler.toml after Cloudflare creates them.

# Cloudinary server-side secrets
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PENDING_SUBMISSIONS_FOLDER=pfseeker/pending-submissions

# Discord OAuth server-side secrets
DISCORD_CLIENT_ID=1523444161951437050
DISCORD_CLIENT_SECRET=
# Local development may use http://localhost:4321/auth/discord/callback or
# http://127.0.0.1:4321/auth/discord/callback when registered in Discord.
DISCORD_REDIRECT_URI=https://pfseeker.com/auth/discord/callback

# Session signing
# Use a strong random value of at least 32 characters. Do not commit real values.
SESSION_SECRET=
